# =============================================================================
# Frontend — El Capo AutoBot (.env.example)
# Copie para Frontend/.env e preencha os valores.
# NÃO coloque SUPABASE_SERVICE_ROLE_KEY aqui. Auth/login é só via backend.
# =============================================================================

# URL do gateway FastAPI (local ou produção)
VITE_API_BASE_URL=http://127.0.0.1:8080

# Deve ser idêntica a PANEL_API_KEY do Backend/.env.local
VITE_PANEL_API_KEY=troque-esta-chave

# Emails com acesso visual ao menu /admin (separados por vírgula)
VITE_ADMIN_EMAILS=admin@seudominio.com

# -----------------------------------------------------------------------------
# NÃO USE MAIS (removidos do fluxo de login):
# VITE_SUPABASE_URL=
# VITE_SUPABASE_ANON_KEY=
# Sessão = cookies httpOnly via POST /auth/login no backend.
# Credenciais Supabase ficam em Backend/.env.local
# -----------------------------------------------------------------------------
