# =============================================================================
# Backend — El Capo AutoBot (.env.example)
# Copie para Backend/.env.local e preencha os valores.
# NUNCA commite .env.local com secrets reais.
# =============================================================================

# Ambiente: development | staging | production
APP_ENV=development

# -----------------------------------------------------------------------------
# Supabase (OBRIGATÓRIO para login/sessão/admin/financeiro)
# Project Settings → API no painel Supabase
# -----------------------------------------------------------------------------
SUPABASE_URL=https://dfxmasxpqpujxahwzpqn.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6ImRmeG1hc3hwcXB1anhhaHd6cHFuIiwicm9sZSI6InNlcnZpY2Vfcm9sZSIsImlhdCI6MTc4NDU3NTg1MCwiZXhwIjoyMTAwMTUxODUwfQ.UpbZww2WYJajun8U6wrgfQQznWLp1Om0Gp4Km9fN5QM

# -----------------------------------------------------------------------------
# Gateway / painel
# -----------------------------------------------------------------------------
# Deve bater com VITE_PANEL_API_KEY do Frontend/.env
PANEL_API_KEY=troque-esta-chave

# Emails admin (fallback local / allowlist). Separados por vírgula.
ADMIN_EMAILS=admin@seudominio.com

# Origins permitidas (CORS). Inclua o frontend local e produção.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,https://app.elcapobot.online

# URL pública do frontend (links de recuperação, redirects)
FRONTEND_URL=https://app.elcapobot.online

# URL pública da API (webhooks / links externos)
PUBLIC_API_URL=http://127.0.0.1:8080

# Em development, permite headers legados x-user-id / x-api-key para QA local.
# Nunca true em production.
AUTH_ALLOW_LEGACY_HEADERS=true

# -----------------------------------------------------------------------------
# BullEx (serviço interno)
# -----------------------------------------------------------------------------
BULLEX_SERVICE_URL=http://127.0.0.1:8001
BULLEX_SESSION_DB_PATH=./data/bullex-sessions.db
BULLEX_MAX_CONCURRENT_API_CALLS=3
# Base64 URL-safe (Fernet / 32 bytes). Gere uma chave própria.
BULLEX_SESSION_ENCRYPTION_KEY=dGVzdC1sb2NhbC1rZXktZWxjYXBvLWJvdC0zMmJ5dGVzIQ==
# Proxy de egress para login HTTP/WS da Bullex (contorna rate limit por IP do VPS).
# Ops apenas — nunca expor no painel do cliente.
#
# Comprar (recomendado): IPRoyal residencial  https://iproyal.com
# Alternativa barata:    Webshare             https://www.webshare.io
# Pedir: 5 proxies HTTP (ou SOCKS5) com user/senha.
#
# Formato: http://USUARIO:SENHA@HOST:PORTA  (5 itens, vírgula, sem espaços)
# BULLEX_PROXY_URLS=http://u:p@ip1:porta,http://u:p@ip2:porta,http://u:p@ip3:porta,http://u:p@ip4:porta,http://u:p@ip5:porta
BULLEX_PROXY_URL=
BULLEX_PROXY_URLS=

# Persistência local do robô (quando não usa só Supabase)
ROBOT_DB_PATH=./data/backend-persistence.db
ROBOT_REAL_MAX_ENTRY=10

# -----------------------------------------------------------------------------
# Webhooks de saída (opcional em local)
# Prefixo segue APP_ENV: DEV_ | STAGING_ | PROD_
# -----------------------------------------------------------------------------
DEV_WEBHOOKS_ENABLED=false
# 32 bytes em Base64 URL-safe (obrigatório se WEBHOOKS_ENABLED=true)
DEV_ENCRYPTION_KEY=
DEV_REDIS_URL=redis://127.0.0.1:6379/0

# -----------------------------------------------------------------------------
# Emails nativos (SMTP Hostinger recomendado, ou Resend)
# Prefixo: DEV_ | STAGING_ | PROD_
# -----------------------------------------------------------------------------
DEV_EMAILS_ENABLED=false
DEV_EMAIL_PROVIDER=smtp
DEV_SMTP_HOST=smtp.hostinger.com
DEV_SMTP_PORT=465
DEV_SMTP_USE_SSL=true
DEV_SMTP_USERNAME=suporte@visaodarota.com
DEV_SMTP_PASSWORD=
DEV_EMAIL_FROM="ElCapo AutoBot <suporte@visaodarota.com>"
# Alternativa Resend (só se EMAIL_PROVIDER=resend):
# DEV_EMAIL_PROVIDER=resend
# DEV_RESEND_API_KEY=# -----------------------------------------------------------------------------
# Cakto / financeiro (opcional em local)
# Prefixo: DEV_ | STAGING_ | PROD_
# -----------------------------------------------------------------------------
DEV_CAKTO_ENABLED=false
DEV_CAKTO_WEBHOOK_SECRET=
DEV_CAKTO_OAUTH_CLIENT_ID=
DEV_CAKTO_OAUTH_CLIENT_SECRET=
# DEV_CAKTO_OAUTH_TOKEN=
# Produto único da conta Cakto; novas ofertas do financeiro são criadas nele.
DEV_CAKTO_DEFAULT_PRODUCT_ID=
DEV_CAKTO_API_BASE_URL=https://api.cakto.com.br
